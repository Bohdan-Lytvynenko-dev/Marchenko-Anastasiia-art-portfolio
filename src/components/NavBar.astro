---
import siteConfig from '../../site.config.mts';

const title = siteConfig.title;

const base = import.meta.env.BASE_URL;
const normalizedBase = base.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const homePath = normalizedBase || '/';

const menuItems = [
	{ name: 'Portfolio', link: `${normalizedBase}/` },
	{ name: 'About', link: `${normalizedBase}/about` },
	{ name: 'Contact', link: `${normalizedBase}/contact` },
];

const isItemActive = (link: string) => {
	const normalizedLink = link.replace(/\/$/, '') || '/';
	if (normalizedLink === homePath) {
		return currentPath === homePath;
	}
	return currentPath.startsWith(normalizedLink);
};
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400..700&display=swap"
	rel="stylesheet"
/>

<nav
	x-data="{ isOpen: false, scrolled: false }"
	@scroll.window="scrolled = window.scrollY > 50"
	class="fixed top-0 left-0 w-full z-50 transition-all duration-300"
	:class="scrolled ? 'py-3 bg-white shadow-sm' : 'py-5 bg-transparent'"
>
	<div class="container mx-auto flex justify-between items-center">
		<a href={`${normalizedBase}/`} id="logo" class="text-2xl md:text-4xl font-semibold tracking-tight">
			{title}
		</a>

		<!-- Desktop Menu -->
		<div class="hidden md:flex space-x-8">
			{
				menuItems.map((item) => {
					const active = isItemActive(item.link);
					return (
						<a
							href={item.link}
							class:list={[
								'nav-link',
								active && 'active font-semibold text-black',
							]}
							aria-current={active ? 'page' : undefined}
						>
							{item.name}
						</a>
					);
				})
			}
		</div>

		<!-- Mobile Menu Button -->
		<button @click="isOpen = !isOpen" class="md:hidden text-gray-800 focus:outline-none">
			<svg x-show="!isOpen" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
			<svg x-show="isOpen" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M6 18L18 6M6 6l12 12"></path>
			</svg>
		</button>
	</div>

	<!-- Mobile Menu -->
	<div x-show="isOpen" class="md:hidden absolute top-full left-0 w-full bg-white shadow-md">
		<div class="flex flex-col py-4 px-6 space-y-4">
			{
				menuItems.map((item) => {
					const active = isItemActive(item.link);
					return (
						<a
							href={item.link}
							class:list={[
								'text-lg transition-colors',
								active ? 'font-semibold text-black underline underline-offset-4' : 'text-gray-600 hover:text-black',
							]}
							@click="isOpen = false"
							aria-current={active ? 'page' : undefined}
						>
							{item.name}
						</a>
					);
				})
			}
		</div>
	</div>
</nav>
